# Motor de rutas por calles (src/lib/routes.ts). Con MAPBOX_TOKEN se usa Mapbox Directions
# con tráfico en vivo; sin él, el OSRM público (gratis, sin tráfico, con ajuste por hora pico);
# si ninguno responde, se estima en línea recta × 1.3.
# MAPBOX_TOKEN="pk.xxxxx"
# ROUTES_PROVIDER: auto (por defecto) | mapbox | osrm | estimada (nunca usa la red; úsalo en pruebas y sin internet)
# ROUTES_PROVIDER="auto"
