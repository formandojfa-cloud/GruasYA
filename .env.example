# PostgreSQL. En producción, la cadena de Supabase: Project Settings → Database → Connection string
# → "Session pooler" (URI). En desarrollo, un Postgres local (scripts/pg-local.sh lo levanta en el 5433).
DATABASE_URL="postgresql://postgres@localhost:5433/gruaya_dev"
# DATABASE_POOL_MAX=5
# Secreto para que Supabase (pg_cron) llame a /api/tick cada 10 s y la cascada avance sin nadie mirando.
# TICK_SECRET="cambia-esto"
AUTH_SECRET="dev-only-change-me"
PBX_PASSWORD="pbx123"

# Motor de rutas por calles (src/lib/routes.ts). Con MAPBOX_TOKEN se usa Mapbox Directions
# con tráfico en vivo; sin él, el OSRM público (gratis, sin tráfico, con ajuste por hora pico);
# si ninguno responde, se estima en línea recta × 1.3.
# MAPBOX_TOKEN="pk.xxxxx"
# El mismo MAPBOX_TOKEN también pinta el mapa (teselas Mapbox Light); sin él se usa CARTO Positron gratis.
# Teléfono de la Central que ven cliente y piloto en "Soporte" (llamar / WhatsApp). 8 dígitos de Guatemala.
# NEXT_PUBLIC_CENTRAL_PHONE="5555-0000"
# ROUTES_PROVIDER: auto (por defecto) | mapbox | osrm | estimada (nunca usa la red; úsalo en pruebas y sin internet)
# ROUTES_PROVIDER="auto"
