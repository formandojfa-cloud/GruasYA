# Copia este archivo como .env en la raíz del proyecto (junto a docker-compose.yml) y rellena.

# Dominio con el que entras a la app. Si no tienes dominio, usa la IP del VPS con sslip.io,
# p. ej. 203.0.113.5.sslip.io (Caddy saca el certificado HTTPS igual). El GPS del navegador exige HTTPS.
DOMINIO=gruaya.tudominio.com

# Supabase → Project Settings → Database → Connection string → Session pooler (URI), con tu contraseña.
DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Secreto largo y aleatorio para firmar las sesiones (openssl rand -hex 32).
AUTH_SECRET=cambia-esto-por-algo-largo
# Contraseña del panel de la Central (/pbx).
PBX_PASSWORD=cambia-esto

# Opcionales
MAPBOX_TOKEN=            # pk.… rutas con tráfico y mapa estilo Uber (sin él: OSRM + CARTO, gratis)
NEXT_PUBLIC_CENTRAL_PHONE=5555-0000   # teléfono real de la Central para "Soporte"
SEED_DEMO=1             # 1 = carga clientes y grúas de prueba al arrancar (ponlo en 0 cuando haya datos reales)
TICK_SECRET=            # solo si además quieres el latido desde Supabase (supabase/motor.sql); en un VPS no hace falta
NOMINATIM_USER_AGENT=gruaya-vps/0.1
